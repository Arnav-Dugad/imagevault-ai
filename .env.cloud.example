# Copy to .env.cloud. Never commit credentials. See docs/cloud-deployment.md.
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT_URL=https://YOUR_ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=imagevault
# For laptop use: dedicated storage account connection string (AccountKey).
# On Azure VM prefer managed identity; leave this blank and assign Blob Data Contributor.
AZURE_STORAGE_CONNECTION_STRING=
S3_BUCKET=
S3_REGION=ap-south-1
# AWS: leave blank on EC2 with an instance role. Temporary credentials need all three.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
POSTGRES_USER=imagevault
POSTGRES_DB=imagevault
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql+asyncpg://imagevault:REPLACE_WITH_SAME_RANDOM_HEX@postgres:5432/imagevault
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
REGISTRATION_ENABLED=false
CORS_ORIGINS=http://localhost:8080
PRESIGNED_URL_EXPIRE_MINUTES=15
# Only required for the optional TLS override: DNS name pointing to your VM.
PUBLIC_HOSTNAME=vault.example.com
