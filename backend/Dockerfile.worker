FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TORCH_HOME=/home/imagevault/.cache/torch \
    HF_HOME=/home/imagevault/.cache/huggingface \
    FACE_DETECTOR_MODEL_PATH=/opt/imagevault/models/face_detection_yunet_2023mar.onnx \
    FACE_RECOGNIZER_MODEL_PATH=/opt/imagevault/models/face_recognition_sface_2021dec.onnx

RUN groupadd --system imagevault && useradd --system --gid imagevault --create-home imagevault
WORKDIR /app

RUN apt-get update && \
    apt-get install --yes --no-install-recommends ca-certificates curl tesseract-ocr tesseract-ocr-eng && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/imagevault/models && \
    curl --fail --location --retry 5 --retry-all-errors \
      "https://huggingface.co/opencv/face_detection_yunet/resolve/main/face_detection_yunet_2023mar.onnx?download=true" \
      --output /opt/imagevault/models/face_detection_yunet_2023mar.onnx && \
    curl --fail --location --retry 5 --retry-all-errors \
      "https://huggingface.co/opencv/face_recognition_sface/resolve/main/face_recognition_sface_2021dec.onnx?download=true" \
      --output /opt/imagevault/models/face_recognition_sface_2021dec.onnx && \
    echo "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4  /opt/imagevault/models/face_detection_yunet_2023mar.onnx" | sha256sum --check --strict && \
    echo "0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79  /opt/imagevault/models/face_recognition_sface_2021dec.onnx" | sha256sum --check --strict

COPY pyproject.toml ./
COPY app ./app
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN pip install --upgrade pip && \
    pip install --index-url "${TORCH_INDEX_URL}" torch==2.7.0 torchvision==0.22.0 && \
    pip install '.[worker]'

RUN mkdir -p /home/imagevault/.cache && chown -R imagevault:imagevault /home/imagevault
USER imagevault
EXPOSE 9101

CMD ["celery", "-A", "app.worker.celery_app:celery_app", "worker", "--loglevel=INFO", "--concurrency=1"]
