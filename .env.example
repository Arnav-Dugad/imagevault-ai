# Copy this file to .env before starting Docker Compose.
# Generate independent secrets in PowerShell with:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})

APP_VERSION=1.2.1
ENVIRONMENT=development
POSTGRES_USER=imagevault
POSTGRES_DB=imagevault
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://imagevault:REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD@postgres:5432/imagevault

MINIO_ACCESS_KEY=imagevault
MINIO_SECRET_KEY=REPLACE_WITH_A_RANDOM_MINIO_SECRET
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET=imagevault

REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost,http://localhost:5173

MAX_UPLOAD_BYTES=15728640
MAX_VIDEO_UPLOAD_BYTES=314572800
MAX_BATCH_FILES=20
VISUAL_SIMILARITY_THRESHOLD=0.85
PERCEPTUAL_HASH_THRESHOLD=8
SIMILARITY_CANDIDATE_LIMIT=60
PERCEPTUAL_PREFILTER_DISTANCE=18
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
ANALYSIS_VERSION=6
FACE_CLUSTER_THRESHOLD=0.30
AI_DEVICE=auto
MEDIA_SAMPLE_FRAMES=6
OCR_LANGUAGES=eng+hin+mar+ben+tam+tel+guj+pan

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_GRAFANA_PASSWORD

# Local monitoring only. Clear these URLs if monitoring is not installed.
GRAFANA_URL=http://localhost:3001
PROMETHEUS_URL=http://localhost:9090
REGISTRATION_ENABLED=true
REGISTRATION_CODE=
MAX_USER_STORAGE_BYTES=0
