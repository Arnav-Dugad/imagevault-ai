infra/*.tfstate.*
infra/terraform.tfvars
infra/*.tfplan

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
.playwright-mcp/

# Laptop AI worker settings (contain the database password)
worker.env
infra/tfplan
